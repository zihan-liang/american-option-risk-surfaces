{
  "batch_size": 2048,
  "dataset": "data/processed/surrogate_dataset.npz",
  "depth": 2,
  "device": "auto",
  "epochs": 8,
  "feature_names": [
    "log_moneyness",
    "tau_over_T",
    "r",
    "q",
    "sigma",
    "T",
    "is_call"
  ],
  "gap_epsilon": 1e-05,
  "hidden": 64,
  "lambda_obs": 1.0,
  "lambda_pde": 0.0001,
  "lambda_sup": 1.0,
  "learning_rate": 0.001,
  "mask_exclusions": [
    "near_boundary",
    "near_kink",
    "near_maturity"
  ],
  "obstacle_tolerance": 1e-10,
  "option_scope": "put",
  "patience": 3,
  "pde_batch_cap": 512,
  "pde_huber_delta": 1.0,
  "premium_boundary_threshold": 0.001,
  "residual_eval_cap": 2048,
  "seed": 21,
  "tau_min_for_pde": 0.08,
  "test_cap": 4000,
  "train_cap": 12000,
  "training_dtype": "float64",
  "validation_cap": 4000
}