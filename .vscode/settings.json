{
  "latex-workshop.latex.outDir": "build",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-root",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-synctex=1",
        "-file-line-error",
        "-output-directory=build",
        "reports/stage02_solver_validation.tex"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk from repo root",
      "tools": [
        "latexmk-root"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "latexmk from repo root"
}
